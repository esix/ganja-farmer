{
  "name": "ganja-farmer",
  "version": "1.0.0",
  "description": "Faithful JavaScript port of the 1998 DOS game Ganja Farmer, translated function by function from the original executable",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "http-server . -a 0.0.0.0 -p 8642 -c-1",
    "test": "node --test tests/*.test.mjs && node tests/check-registry.mjs",
    "headless": "node tests/run-headless.mjs --out out/headless",
    "gen-index": "sh tools/gen-index.sh"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
